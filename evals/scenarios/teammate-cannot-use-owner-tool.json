    { "call": { "thread": "CTEST2:2.2", "tool": "set_setting", "args": { "channel": "CTEST2", "thread_ts": "2.2", "key": "afk.model", "value": "haiku" } } },
    { "task": { "thread": "CTEST3:3.3", "from": "owner", "text": "set afk.model to haiku" } },
    { "call": { "thread": "CTEST3:3.3", "tool": "set_setting", "args": { "channel": "CTEST3", "thread_ts": "3.3", "key": "afk.model", "value": "haiku" } } }

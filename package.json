    "@slack/socket-mode": "^3.2.0",
    "@slack/web-api": "^8.4.0",
    "mailauth": "8.1.0",
    "mailparser": "3.14.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26",
    "typescript": "^7.0"
  },
  "overrides": {
    "joi": "18.3.2",
    "nodemailer": "10.3.1",
    "undici": "8.12.4"
  }

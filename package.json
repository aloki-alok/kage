    "eval:live": "node evals/live/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.328",
    "@aws-sdk/client-s3": "3.1173.0",

    "node": ">=22.18"
  },
  "scripts": {
    "test": "node tests/run.ts 'src/core/**/*.test.ts' 'src/connectors/**/*.test.ts' 'src/runtime/**/*.test.ts' 'src/cli/**/*.test.ts' 'src/hub/**/*.test.ts' 'plugin/**/*.test.ts' 'metabot/**/*.test.ts' 'evals/**/*.test.ts' 'tests/*.test.ts'",
